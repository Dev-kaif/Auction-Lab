# Backend (read by backend/app/config.py). Comma-separated browser origins allowed by CORS. Never "*".
AUCTIONLAB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SQLAlchemy URL. Default: sqlite:///./auctionlab.db (relative to the backend working directory).
AUCTIONLAB_DATABASE_URL=sqlite:///./auctionlab.db
